---
---

<section id="demo" aria-label="Product demo" style="padding: 3.5rem 1.5rem 0;">
  <div style="max-width: 900px; margin: 0 auto;">
    <div data-animate style="text-align: center; margin-bottom: 1.5rem;">
      <p style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--sg-primary);margin:0 0 0.5rem;">
        See it in action
      </p>
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:700;letter-spacing:-0.03em;color:var(--sg-text);margin:0;">
        Parallel worktrees, parallel agents, one window.
      </h2>
    </div>

    <div data-animate style="
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--sg-border);
      box-shadow: 0 12px 40px color-mix(in srgb, #000 18%, transparent);
    ">
      <img
        src="/demo.gif"
        alt="Demo: creating worktrees, launching parallel AI agent sessions in each one, reviewing a diff, and merging — all from the same window"
        width="880"
        height="568"
        style="display: block; width: 100%; height: auto;"
        loading="eager"
      />
    </div>
  </div>
</section>
