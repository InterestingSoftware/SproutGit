{
  "name": "@sproutgit/app",
  "version": "0.2.0",
  "private": true,
  "homepage": "https://sproutgit.dev",
  "author": {
    "name": "SproutGit",
    "email": "noreply@sproutgit.dev"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "typecheck": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json",
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.sproutgit.app",
    "productName": "SproutGit",
    "executableName": "SproutGit",
    "copyright": "Copyright © 2026 SproutGit contributors",
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "electronLanguages": ["en"],
    "compression": "maximum",
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "package.json",
      "!node_modules/@agentclientprotocol/claude-agent-acp/**",
      "!node_modules/@agentclientprotocol/codex-acp/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/@openai/codex/**",
      "!node_modules/@openai/codex-*/**",
      "!node_modules/monaco-editor/**",
      "!node_modules/@monaco-editor/**",
      "!node_modules/lucide-react/**",
      "!node_modules/highlight.js/**",
      "!node_modules/@tanstack/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/zustand/**",
      "!node_modules/@radix-ui/**",
      "!node_modules/dompurify/**",
      "!node_modules/@xterm/**",
      "!node_modules/zod/**",
      "!node_modules/seroval/**",
      "!node_modules/seroval-plugins/**",
      "!node_modules/js-yaml/**",
      "!node_modules/argparse/**",
      "!node_modules/@fontsource/**",
      "!node_modules/diff/**",
      "!node_modules/vscode-jsonrpc/**",
      "!node_modules/marked/**",
      "!node_modules/@floating-ui/**",
      "!node_modules/open/**",
      "!node_modules/react-remove-scroll/**",
      "!node_modules/react-remove-scroll-bar/**",
      "!node_modules/react-style-singleton/**",
      "!node_modules/use-callback-ref/**",
      "!node_modules/use-sidecar/**",
      "!node_modules/use-sync-external-store/**",
      "!node_modules/state-local/**",
      "!node_modules/aria-hidden/**",
      "!node_modules/scheduler/**",
      "!node_modules/cookie-es/**",
      "!node_modules/isbot/**"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "SproutGit ${version}",
      "background": "build/background.tiff",
      "window": {
        "width": 540,
        "height": 400
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 150,
          "type": "file"
        },
        {
          "x": 400,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "InterestingSoftware",
      "repo": "SproutGit"
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.63.0",
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@sproutgit/database": "workspace:*",
    "@sproutgit/fs-watch": "workspace:*",
    "@sproutgit/git": "workspace:*",
    "@sproutgit/mcp-client-config": "workspace:*",
    "@sproutgit/paths": "workspace:*",
    "@sproutgit/provider-github": "workspace:*",
    "@sproutgit/terminal": "workspace:*",
    "@sproutgit/types": "workspace:*",
    "@sproutgit/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "driver.js": "^1.8.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.27.0",
    "node-pty": "1.2.0-beta.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@sproutgit/mcp-server": "workspace:*",
    "@sproutgit/ts-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260630.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}